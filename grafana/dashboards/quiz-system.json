{
  "id": null,
  "uid": "quiz-system",
  "title": "DTC245200430 - Quiz System",
  "tags": ["quiz", "docker", "de35"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tổng lượt nộp bài",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "quiz_attempts_total", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Điểm trung bình",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "quiz_average_score", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "MySQL exporter up (1 = healthy)",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"mysql\"}", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Nginx exporter up (1 = healthy)",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"nginx\"}", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU container Quiz",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".*quiz.*\"}[5m]))",
        "legendFormat": "{{name}}",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bộ nhớ container Quiz",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "container_memory_working_set_bytes{name=~\".*quiz.*\"}",
        "legendFormat": "{{name}}",
        "refId": "A"
      }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Lượt làm bài và điểm trung bình",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "quiz_attempts_total", "legendFormat": "Lượt làm bài", "refId": "A"},
        {"expr": "quiz_average_score", "legendFormat": "Điểm trung bình", "refId": "B"}
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Log tập trung - container Quiz",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 21},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{container=~\".*quiz.*\"}", "refId": "A"}]
    }
  ],
  "time": {"from": "now-1h", "to": "now"}
}
